{
  "manifest_version": 3,
  "name": "PhishSentinel",
  "version": "1.0.0",
  "description": "Zero-hour phishing detection — hybrid URL + visual + community + crawler intel.",
  "permissions": ["activeTab", "storage", "notifications", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "PhishSentinel — scan this page",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
